# WhatsApp Configuration for Nexmo (Vonage) API
# Add these to your .env file

# Nexmo API Credentials
NEXMO_API_KEY=your_nexmo_api_key_here
NEXMO_API_SECRET=your_nexmo_api_secret_here

# Your WhatsApp Business Number (provided by Nexmo)
# Format: Must be in international format without + sign
# Example: 14155238886 (for US number +1-415-523-8886)
NEXMO_WHATSAPP_NUMBER=your_whatsapp_business_number_here

# Optional: Default sender for regular SMS (if not using WhatsApp)
SMPP_DEFAULT_SENDER=MYBRANDNAME

# Enable/Disable SMPP for regular SMS
SMPP_ENABLED=true
