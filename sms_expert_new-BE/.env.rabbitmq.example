# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# RabbitMQ Queue Names
RABBITMQ_SMS_QUEUE=sms.outbound
RABBITMQ_PRIORITY_QUEUE=sms.priority
RABBITMQ_FAILED_QUEUE=sms.failed
RABBITMQ_DLR_QUEUE=sms.dlr

# RabbitMQ Retry Configuration
RABBITMQ_MAX_RETRIES=3
RABBITMQ_INITIAL_RETRY_DELAY=10
RABBITMQ_MAX_RETRY_DELAY=300
RABBITMQ_BACKOFF_MULTIPLIER=2

# RabbitMQ Message TTL (in milliseconds)
RABBITMQ_MESSAGE_TTL=86400000
RABBITMQ_FAILED_TTL=300000
RABBITMQ_PRIORITY_TTL=3600000

# RabbitMQ Consumer Configuration
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_CONSUMER_TIMEOUT=0

# SMPP Configuration
SMPP_HOST=smpp1.nexmo.com
SMPP_PORT=8000
SMPP_SYSTEM_ID=your_system_id
SMPP_PASSWORD=your_password
SMPP_DEFAULT_SENDER=MYBRANDNAME
SMPP_TPS_LIMIT=50
SMPP_DETAILED_LOGGING=true
