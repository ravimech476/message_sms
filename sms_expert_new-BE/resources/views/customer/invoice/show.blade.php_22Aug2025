<script>
document.addEventListener('DOMContentLoaded', function() {
    // Auto-hide flash messages
    setTimeout(function() {
        const flashMessages = document.querySelectorAll('#flash-message, #flash-error-message');
        flashMessages.forEach(msg => {
            if (msg) {
                msg.style.opacity = '0';
                msg.style.transform = 'translateY(-20px)';
                setTimeout(() => msg.style.display = 'none', 300);
            }
        });
    }, 4000);

    // Smooth animations
    const elements = document.querySelectorAll('.invoice-document, .bank-transfer-info, .action-buttons');
    elements.forEach((element, index) => {
        element.style.opacity = '0';
        element.style.transform = 'translateY(20px)';
        
        setTimeout(() => {
            element.style.transition = 'all 0.5s ease';
            element.style.opacity = '1';
            element.style.transform = 'translateY(0)';
        }, index * 200);
    });

    // Print button animation
    const printButton = document.querySelector('.print-button');
    if (printButton) {
        printButton.style.opacity = '0';
        printButton.style.transform = 'scale(0) rotate(180deg)';
        
        setTimeout(() => {
            printButton.style.transition = 'all 0.5s ease';
            printButton.style.opacity = '1';
            printButton.style.transform = 'scale(1) rotate(0deg)';
        }, 1000);
    }

    console.log('Invoice details page loaded successfully!');
});

// Enhanced print functionality
function printInvoice() {
    // Hide non-printable elements
    const nonPrintElements = document.querySelectorAll('.breadcrumb-container, .action-buttons, .print-button, .back-button, .alert');
    nonPrintElements.forEach(element => {
        element.style.display = 'none';
    });
    
    // Set print title
    const originalTitle = document.title;
    document.title = `Invoice-${document.querySelector('.invoice-number')?.textContent?.replace('Invoice Number: ', '') || 'Unknown'}`;
    
    // Print the page
    window.print();
    
    // Restore title and elements after printing
    setTimeout(() => {
        document.title = originalTitle;
        nonPrintElements.forEach(element => {
            element.style.display = '';
        });
    }, 1000);
}

// Add multiple ways to trigger print
document.addEventListener('keydown', function(e) {
    // Ctrl+P shortcut
    if (e.ctrlKey && e.key === 'p') {
        e.preventDefault();
        printInvoice();
    }
});

// Update all print button event listeners
document.addEventListener('DOMContentLoaded', function() {
    const printButtons = document.querySelectorAll('[onclick="window.print()"], .print-button');
    printButtons.forEach(button => {
        button.removeAttribute('onclick');
        button.addEventListener('click', function(e) {
