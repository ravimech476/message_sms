APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Admin host for links emailed to staff (Daily Stats download buttons etc.).
# Must point at the admin subdomain so the admin auth middleware can sign
# the recipient in before serving the download. Falls back to APP_URL if unset.
ADMIN_URL=http://localhost

SUPPORT_EMAIL=support@example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Contract CC Email (receives copies of contract-related emails)
CONTRACT_CC_EMAIL=admin@sms.expert

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nexmo/Vonage API Configuration (for SMS sending)
NEXMO_API_KEY=your_nexmo_api_key
NEXMO_API_SECRET=your_nexmo_api_secret

# Nexmo/Vonage Virtual Numbers API Configuration (for buy/cancel/update numbers)
# These credentials are used specifically for Virtual Number management
NEXMO_VN_API_KEY=your_nexmo_vn_api_key
NEXMO_VN_API_SECRET=your_nexmo_vn_api_secret

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SMS_QUEUE=sms.outbound
RABBITMQ_DLR_QUEUE=sms.dlr
RABBITMQ_FAILED_QUEUE=sms.failed
RABBITMQ_PRIORITY_QUEUE=sms.priority
RABBITMQ_INBOUND_QUEUE=sms.inbound
RABBITMQ_CAMPAIGN_QUEUE=campaign.process
# Customer DLR webhook callback queue — drained by `dlr-callback:consume`
# worker. Replaces the legacy 5-minute `delivery-receipt:push` cron with an
# event-driven path (DLR arrives → row inserted → published here → consumer
# POSTs to customer URL within seconds).
RABBITMQ_DLR_CALLBACK_QUEUE=dlr.callback.push
RABBITMQ_MAX_RETRIES=3

# SMPP Configuration
SMPP_ENABLED=true
SMPP_DEFAULT_SENDER=MYBRANDNAME

# When true, the API/dashboard send path PUBLISHES each SMS to RabbitMQ (sms.outbound)
# and returns immediately; the `php artisan sms:process-queue` worker (persistent SMPP
# bind) performs the actual send asynchronously. This avoids blocking the HTTP request
# on a synchronous SMPP connect+submit (the ~100s-timeout / "SMPP Pool Manager not
# available" problem). Requires the sms:process-queue worker to be running (supervisor)
# and RabbitMQ up. Leave false to keep the legacy synchronous send. Flip to true only
# after confirming the worker is running; set back to false for instant rollback.
SMS_ASYNC_PUBLISH=false

# SMPP throttling (mirrors OLD SYSTEM registerMessageSendWithThrottle + reschedule-on-throttle).
# PROACTIVE per-second send cap uses the EXISTING SMPP_TPS_LIMIT below. applySendRateLimit()
#   increments a per-second counter via Laravel's default cache before each submit_sm and sleeps
#   to stay under it, so Vonage never returns ESME_RTHROTTLED (88). Uses whatever CACHE_STORE is
#   set (file/database/redis) — no Redis required. The counter is shared across all workers on the
#   SAME server (file cache) or across servers too (database/redis). OLD SYSTEM value = 100.
# SMPP_THROTTLE_MAX_RETRIES: REACTIVE fallback — if an 88 still occurs, back off + retry the same
#   part this many times (exponential, capped 3s) before failing the message. Default 5.
SMPP_THROTTLE_MAX_RETRIES=5

# When true, the sms:process-queue worker binds Vonage/Nexmo as a TRANSMITTER (send-only)
# instead of a transceiver. A transmitter bind does NOT receive deliver_sm, so the send
# worker's submit_sm_resp is never starved by the DLR flood — each send completes in
# milliseconds (fixes the ~2-5 min/msg stall and the empty deliveryreceipt1). REQUIRES a
# separate DLR receiver to be running (smpp:dlr-receiver / webhook / nexmo:process-delivery-queue),
# because the send worker no longer receives DLRs itself. Default false = transceiver (unchanged).
SMPP_SEND_TRANSMITTER_ONLY=false

# Per-server submission-reference suffix (OLD SYSTEM $thisserverbasebatchnums).
# Customer API response is "0|sms submitted|<bigid>-<SERVER_BASE_BATCH_NUM>".
# Live OLD SYSTEM server (site7 "Elephant") = 3. Set per deployment/server.
SERVER_BASE_BATCH_NUM=3

# Customer SMPP Server Configuration
CUSTOMER_SMPP_HOST=0.0.0.0
CUSTOMER_SMPP_PORT=2775
CUSTOMER_SMPP_PUBLIC_HOST=127.0.0.1
CUSTOMER_SMPP_SYSTEM_ID=SMSEXPERT

# ==============================================
# SMPP CONFIGURATION (OLD SYSTEM COMPATIBLE)
# ==============================================
# Based on OLD SYSTEM thisserver_details.inc pattern
# Key concepts:
#   - Multiple credential sets (a-j) for parallel daemon operation
#   - seq_id_range: Unique message ID ranges per daemon
#   - systemType: Identifies daemon for DLR error code mapping
#   - Provider codes: P1=mblox, P3=nexmo, P5=ice, P6=tek, P7=routem

# Sinch SMPP Configuration (formerly mBlox)
SINCH_SMPP_HOST=smpp4.mblox.com
SINCH_SMPP_PORT=3200
SINCH_SMPP_SYSTEM_ID=your_system_id
SINCH_SMPP_PASSWORD=your_password
SINCH_SMPP_SENDER=SMSEXPERT
SINCH_SMPP_SYSTEM_TYPE=smppProd1
SINCH_SMPP_PROFILE=21839
SINCH_SMPP_PRIMARY_HOST=smpp4.mblox.com
SINCH_SMPP_SECONDARY_HOST=smpp4.mblox.com
SINCH_SMPP_SEQ_ID_MIN=1
SINCH_SMPP_SEQ_ID_MAX=2000000
SINCH_SMPP_TPS_LIMIT=50
SINCH_SMPP_TIMEOUT=30
SINCH_SMPP_KEEPALIVE=60
SINCH_SMPP_RECV_TIMEOUT=10000

# ----------------------------------------------------------------------------
# Sinch SMPP Multi-Bank DLR Bind Configuration
# ----------------------------------------------------------------------------
# Set SINCH_BANKS_ENABLED=true to run 10 parallel Sinch transceiver binds, one
# per bank (a..j), each with a partitioned seq_id range. Mirrors OLD SYSTEM
# architecture (sites/thisserver_details.inc:92-184) — 5 different systemType
# values (smppProd1..smppProd5), 2 banks each, for ~10x DLR receive throughput.
#
# REQUIREMENT: Sinch must have enabled multi-bind / concurrent-session mode on
# the SMPP account. Without it, every bank past 'a' will be rejected with
# ESME_RALYBND. Confirm with Sinch support before flipping this on.
#
# Per-bank overrides are optional — by default each bank inherits SINCH_SMPP_HOST,
# SINCH_SMPP_PORT, SINCH_SMPP_SYSTEM_ID, SINCH_SMPP_PASSWORD, and
# SINCH_SMPP_PROFILE from above. systemType cycles through smppProd1..smppProd5
# (2 banks per value). See config/sinch_banks.php for the full list of overrides.
SINCH_BANKS_ENABLED=false
SINCH_BANK_DEFAULT=a

# Vonage/Nexmo SMPP Configuration
SMPP_CONNECTION=vonage
SMPP_HOSTS=smpp1.nexmo.com,smpp2.nexmo.com
SMPP_PORT=8000
SMPP_SYSTEM_ID=your_system_id
SMPP_PASSWORD=your_password
SMPP_TYPE=smpp
SMPP_BIND_TYPE=transceiver
SMPP_DEFAULT_SENDER=MYBRANDNAME

# ----------------------------------------------------------------------------
# SMPP Multi-Bank DLR Bind Configuration (Vonage)
# ----------------------------------------------------------------------------
# Set SMPP_BANKS_ENABLED=true to run 10 parallel SMPP transceiver binds, one
# per bank (a0..j0), each with a partitioned seq_id range. Mirrors OLD SYSTEM
# architecture for ~10x DLR receive throughput.
#
# REQUIREMENT: Vonage must have enabled multi-bind / concurrent-session mode
# on the SMPP account. Without it, every bank past the first will be rejected
# with ESME_RALYBND. Confirm with Vonage support before flipping this on.
#
# Per-bank overrides are optional — by default each bank inherits SMPP_HOST,
# SMPP_PORT, SMPP_SYSTEM_ID, SMPP_PASSWORD, and SMPP_TYPE from above.
# Override individual banks via SMPP_BANK_A0_*, SMPP_BANK_B0_*, etc.
# See config/smpp_banks.php for the full list of available overrides.
SMPP_BANKS_ENABLED=false
SMPP_BANK_DEFAULT=a0
# Multi-host distribution for the 10 Vonage banks — avoids traffic
# concentration on a single POP. Vonage exposes 3 EU SMPP hosts (verified
# via DNS); smpp-eu-3 and smpp-eu-4 do NOT exist. Distribution:
#   a0,b0,c0,d0 → SMPP_HOST_1 (4 banks, smpp-eu)
#   e0,f0,g0    → SMPP_HOST_2 (3 banks, smpp-eu-1)
#   h0,i0,j0    → SMPP_HOST_3 (3 banks, smpp-eu-2)
# Override per-bank with SMPP_BANK_<key>_HOST if needed.
# SMPP_HOST_1=smpp-eu.vonage.com
# SMPP_HOST_2=smpp-eu-1.vonage.com
# SMPP_HOST_3=smpp-eu-2.vonage.com

# Vonage Global Account (for international SMS)
SMPP_VONAGE_GLOBAL_SYSTEM_ID=your_global_system_id
SMPP_VONAGE_GLOBAL_PASSWORD=your_global_password
SMPP_VONAGE_PORT=8000

# Vonage Direct Account (for UK+Australia)
SMPP_VONAGE_DIRECT_SYSTEM_ID=your_direct_system_id
SMPP_VONAGE_DIRECT_PASSWORD=your_direct_password

# Route Mobile SMPP
ROUTEMOBILE_SMPP_SYSTEM_ID=
ROUTEMOBILE_SMPP_PASSWORD=
ROUTEMOBILE_SMPP_PORT=2346

# ICE Messaging SMPP
ICE_SMPP_SYSTEM_ID=
ICE_SMPP_PASSWORD=
ICE_SMPP_PORT=21022
ICE_SMPP_PORT_DLR=21033

# TEK SMPP
TEK_SMPP_SYSTEM_ID=
TEK_SMPP_PASSWORD=
TEK_SMPP_PORT=9500

# SMPP Settings
SMPP_TIMEOUT=30
SMPP_KEEPALIVE=60
SMPP_TPS_LIMIT=50

# SMPP Throttle Settings (per provider)
SMPP_THROTTLE_MBLOX=50
SMPP_THROTTLE_VONAGE_GLOBAL=100
SMPP_THROTTLE_VONAGE_DIRECT=100
SMPP_THROTTLE_ROUTEMOBILE=100
SMPP_THROTTLE_ICE=100
SMPP_THROTTLE_TEK=100

# SMPP Sequence ID Storage (redis, database, or file)
SMPP_SEQ_ID_STORAGE=redis

# SMPP Alerts
# Sends an email when any SMPP error happens (connect/bind/send failures,
# DLR receiver crashes, etc.). Throttled per-subject so the same failure
# doesn't flood the inbox during an outage.
SMPP_ALERT_ENABLED=true
# Comma-separated recipients for SMPP failure alerts.
SMPP_ALERT_EMAIL=admin@example.com
# Minimum cooldown between alerts for the SAME subject, in minutes. Default 15.
# Note: primary throttle is now "one email per incident" — once an alert
# fires it stays suppressed until the SMPP service recovers (next successful
# bind triggers SmppErrorAlertService::clear) OR a 24-hour safety net
# expires. This cooldown adds extra protection against rapid fail/recover
# flapping triggering email bursts.
SMPP_ALERT_THROTTLE_MINUTES=15
# Optional: from-name override for alert emails. Falls back to MAIL_FROM_NAME.
# SMPP_ALERT_FROM_NAME="SMS Expert SMPP Monitor"

DLR_WEBHOOK_URL=

